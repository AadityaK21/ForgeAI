generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  sessions     Session[]
  projects     Project[]
  conversations Conversation[]
  memoryEnabled Boolean @default(false)
  memories PreferenceMemory[]
}
model Conversation {
  id        String @id @default(cuid())
  ownerId   String
  owner     User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  title     String @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lease     String?
  leaseUntil DateTime?
  agentMode Boolean @default(false)
  messages  ChatMessage[]
  @@index([ownerId,updatedAt])
}
model ChatMessage {
  id             String @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields:[conversationId],references:[id],onDelete:Cascade)
  role           String
  content        String @default("")
  status         String @default("complete")
  error          String?
  model          String?
  agentRuns      AgentRun[]
  requestId      String?
  createdAt      DateTime @default(now())
  @@unique([conversationId,requestId])
  @@index([conversationId,createdAt])
}
model Session {
  digest    String @id
  userId    String
  expiresAt DateTime
  user      User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([expiresAt])
}
model AuthAttempt {
  key       String @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}
model Project {
  id          String @id @default(cuid())
  title       String
  ownerId     String?
  owner       User? @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  blueprint   String?
  @@index([ownerId,updatedAt])
  revision    Int @default(0)
  preview     String?
  sandboxId   String?
  install     String @default("")
  start       String @default("npm run dev")
  lease       String?
  leaseUntil  DateTime?
  files       SourceFile[]
  runs        Run[]
  assets      PreviewAsset[]
  collections CollectionState[]
  records     ProjectRecord[]
  updatedAt   DateTime @updatedAt
}
model PreviewAsset {
  projectId String
  sandboxId String
  html      String
  project   Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  @@id([projectId,sandboxId])
}
model CollectionState {
  projectId String
  name      String
  project   Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  @@id([projectId,name])
}
model ProjectRecord {
  projectId  String
  collection String
  id         String
  data       String
  createdAt  DateTime @default(now())
  project    Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  @@id([projectId,collection,id])
  @@index([projectId,collection,createdAt])
}
model SourceFile {
  projectId String
  path      String
  content   String
  project   Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  @@id([projectId,path])
}
model Run {
  id        String @id @default(cuid())
  projectId String
  prompt    String
  status    String
  report    String @default("")
  createdAt DateTime @default(now())
  project   Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  @@index([projectId,createdAt])
}

model AgentRun {
  contextSnapshot String?
  id String @id @default(cuid())
  messageId String
  message ChatMessage @relation(fields:[messageId],references:[id],onDelete:Cascade)
  status String @default("running")
  model String
  tokens Int @default(0)
  cost Float @default(0)
  createdAt DateTime @default(now())
  finishedAt DateTime?
  steps AgentStep[]
  checkpoint AgentCheckpoint?
  reservation AgentReservation?
  @@index([messageId,createdAt])
}
model AgentStep {
  id String @id
  runId String
  run AgentRun @relation(fields:[runId],references:[id],onDelete:Cascade)
  name String
  input String
  preview String
  failed Boolean @default(false)
  sources String @default("[]")
  createdAt DateTime @default(now())
  output AgentOutput?
  confirmation AgentConfirmation?
  @@index([runId,createdAt])
}
model AgentOutput {
  stepId String @id
  step AgentStep @relation(fields:[stepId],references:[id],onDelete:Cascade)
  content String
}

model PreferenceMemory {
  id String @id @default(cuid())
  ownerId String
  owner User @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  category String
  value String
  source String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  @@unique([ownerId,category])
  @@index([ownerId,expiresAt])
}

model AgentCheckpoint {
  runId String @id
  run AgentRun @relation(fields:[runId],references:[id],onDelete:Cascade)
  state String
  provider String
  expiresAt DateTime
}
model AgentConfirmation {
  stepId String @id
  step AgentStep @relation(fields:[stepId],references:[id],onDelete:Cascade)
  status String @default("pending")
  tainted Boolean @default(false)
  undoId String?
  expiresAt DateTime
}
model AgentSpend {
  day String @id
  micros Int @default(0)
}
model AgentReservation {
  runId String @id
  run AgentRun @relation(fields:[runId],references:[id],onDelete:Cascade)
  day String
  micros Int
  settled Boolean @default(false)
}
model AgentAudit {
  id String @id @default(cuid())
  userId String
  runId String
  tool String
  arguments String
  resultSize Int @default(0)
  durationMs Int @default(0)
  status String
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model MemoryUndo {
  id String @id @default(cuid())
  ownerId String
  category String
  memoryId String
  savedAt DateTime
  previous String?
  expiresAt DateTime
  used Boolean @default(false)
  @@index([ownerId])
}
