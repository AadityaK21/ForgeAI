generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  sessions     Session[]
  projects     Project[]
}
model Session {
  digest    String @id
  userId    String
  expiresAt DateTime
  user      User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([expiresAt])
}
model AuthAttempt {
  key       String @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}
model Project {
  id          String @id @default(cuid())
  title       String
  ownerId     String?
  owner       User? @relation(fields:[ownerId],references:[id],onDelete:Cascade)
  blueprint   String?
  @@index([ownerId,updatedAt])
  revision    Int @default(0)
  preview     String?
  sandboxId   String?
  install     String @default("")
  start       String @default("npm run dev")
  lease       String?
  leaseUntil  DateTime?
  files       SourceFile[]
  runs        Run[]
  updatedAt   DateTime @updatedAt
}
model SourceFile {
  projectId String
  path      String
  content   String
  project   Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  @@id([projectId,path])
}
model Run {
  id        String @id @default(cuid())
  projectId String
  prompt    String
  status    String
  report    String @default("")
  createdAt DateTime @default(now())
  project   Project @relation(fields:[projectId],references:[id],onDelete:Cascade)
  @@index([projectId,createdAt])
}
