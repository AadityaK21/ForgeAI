DATABASE_URL="file:./dev.db"
# Vercel: a separate Turso database, connected to ForgeAI only.
# The local DATABASE_URL stays a file URL for Prisma schema tooling.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set to preview only on an isolated preview database, never production.
FORGE_DATABASE_ENV=
# Server-only cloud credentials. E2B is optional for the built-in and Docker engines.
E2B_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model and sandbox template overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-5.4-mini
E2B_TEMPLATE=
# Local Ollama model for offline and automatic generation
MEROVA_LOCAL_MODEL=
# Required for access when hosting the private workspace in production
BUILDER_ACCESS_TOKEN=
# Public HTTPS origin when a reverse proxy changes the request origin
FORGE_PUBLIC_ORIGIN=
# Hosted deployment only: absolute persistent root for workspace.db and projects/.
# Leave blank for local development's existing .sandboxes folder.
FORGE_DATA_DIR=

# Optional. Set using npm run settings:owner -- <existing-account-email>
FORGE_SETTINGS_ADMIN_ID=

# Optional server-only loopback Ollama port; defaults to 11434.
MEROVA_OLLAMA_PORT=11434
