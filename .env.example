DATABASE_URL="file:./dev.db"
# Vercel: a separate Turso database, connected to ForgeAI only.
# The local DATABASE_URL stays a file URL for Prisma schema tooling.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Set to preview only on an isolated preview database, never production.
FORGE_DATABASE_ENV=
# Server-only cloud credentials. E2B is optional for the built-in and Docker engines.
E2B_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model and sandbox template overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-5.4-mini
E2B_TEMPLATE=
# Local Ollama model for offline and automatic generation
MEROVA_LOCAL_MODEL=
# Required for access when hosting the private workspace in production
BUILDER_ACCESS_TOKEN=
# Public HTTPS origin when a reverse proxy changes the request origin
FORGE_PUBLIC_ORIGIN=
# Hosted deployment only: absolute persistent root for workspace.db and projects/.
# Leave blank for local development's existing .sandboxes folder.
FORGE_DATA_DIR=

# Optional. Set using npm run settings:owner -- <existing-account-email>
FORGE_SETTINGS_ADMIN_ID=

# Optional server-only loopback Ollama port; defaults to 11434.
MEROVA_OLLAMA_PORT=11434

# Agent mode only: server keys above are required; personal request keys are ignored.
# Search backend for web_search. Currently supported: brave. Blank disables search.
AGENT_SEARCH_PROVIDER=
# Brave Search API subscription token, server only. Never expose as NEXT_PUBLIC.
BRAVE_SEARCH_API_KEY=
# Explicit per-model input/output USD prices per million tokens and context token cap.
# Empty denies all agent models. Enter verified current prices for each allowed model.
# Shape: {"your-model-id":{"input":number,"output":number,"context":32000}}
# Fixed run ceilings: 12 calls/rounds, 120 seconds, 60000 tokens, USD 0.50 estimated.
# Search reserves USD 0.01 per call. Recheck that allowance before changing search plans.
AGENT_MODEL_BUDGETS={}

# Agent safety: positive limits, USD estimates. UTC day boundaries.
# Any nonempty value other than false disables agent mode (normal chat still works).
AGENT_DISABLED=false
AGENT_REQUESTS_PER_MINUTE=5
AGENT_RUNS_PER_DAY=30
AGENT_MAX_TOKENS=60000
AGENT_MAX_COST_USD=0.5
AGENT_DAILY_SPEND_USD=10
# Comma-separated internal User IDs, not emails. Empty denies all audit readers.
AGENT_ADMIN_USER_IDS=
