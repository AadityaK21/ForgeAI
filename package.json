{
  "name": "merova-web-builder",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "start": "next start -p 3000",
    "build": "prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "setup": "node prisma/prepare.mjs && prisma generate && prisma db push --skip-generate && node prisma/seed.mjs",
    "test": "tsx --test tests/*.test.ts",
    "settings:owner": "tsx prisma/settings-owner.ts",
    "test:browser": "node tests/workspace-browser.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@e2b/code-interpreter": "^2.9.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "esbuild": "0.28.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "monaco-editor": "0.52.2",
    "next": "^15.5.0",
    "openai": "^7.47.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.0",
    "typescript": "~5.9.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "playwright": "1.64.1",
    "postcss": "^8",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4"
  }
}
